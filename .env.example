# Local defaults: English only, no indexing, no online submissions or analytics.
# Confirm the production origin before changing this. No localhost canonicals by default.
# SITE_URL=https://your-confirmed-domain.example
SITE_PUBLIC=false
INQUIRY_ENABLED=false
# Approved full plain-text notice and revision. Do not enter draft legal text.
PRIVACY_NOTICE=
PRIVACY_REVISION=
# Resend verified sender and recipient; server only. Do not commit real values.
EMAIL_API_KEY=
INQUIRY_FROM=
INQUIRY_TO=
# Upstash REST Redis: shared limits and 24-hour hashed idempotency state.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
# Supported deployment: Vercel, which overwrites this header. Do not set on a
# host that allows clients to spoof it. Other hosts require an adapter review.
TRUSTED_CLIENT_IP_HEADER=
